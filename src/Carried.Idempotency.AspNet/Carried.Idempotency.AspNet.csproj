<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <PackageId>Carried.Idempotency.AspNet</PackageId>
        <Authors>Carried</Authors>
        <Description>
            ASP.NET Core integration for Carried.Idempotency.
        </Description>

        <PackageTags>idempotency;aspnetcore;dotnet;http</PackageTags>

        <PackageProjectUrl>https://github.com/Carried520/Carried.Idempotency</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Carried520/Carried.Idempotency</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>


    <ItemGroup>
        <None Include="..\..\README.md"
              Pack="true"
              PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Carried.Idempotency.DependencyInjection\Carried.Idempotency.DependencyInjection.csproj" />
        <ProjectReference Include="..\Carried.Idempotency\Carried.Idempotency.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11"/>
    </ItemGroup>

</Project>
