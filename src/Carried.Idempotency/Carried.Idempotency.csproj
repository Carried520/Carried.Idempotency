<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <PackageId>Carried.Idempotency</PackageId>
        <Authors>Carried</Authors>
        <Description>
            A lightweight, storage-agnostic idempotency engine for .NET.
        </Description>

        <PackageTags>idempotency;dotnet;distributed-systems</PackageTags>

        <PackageProjectUrl>https://github.com/Carried520/Carried.Idempotency</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Carried520/Carried.Idempotency</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md"
              Pack="true"
              PackagePath="\"/>
    </ItemGroup>

</Project>
